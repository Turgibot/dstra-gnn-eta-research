# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── LaTeX build artifacts ─────────────────────────────────────────────────────
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
Papers/Springer/main/main.pdf

# ── Internal Claude tooling (not for publication) ─────────────────────────────
CLAUDE.md

# ── Datasets: large data files (not tracked — acquire via pipeline) ───────────
datasets/
# Porto graph: raw snapshots, labels, and road-topology JSON (35 MB)
datasets/real/porto_taxi_graph/snapshots/
datasets/real/porto_taxi_graph/labels/
datasets/real/porto_taxi_graph/static.json
# Porto trajectory: raw CSVs and processed outputs
datasets/real/porto_taxi_traj/train.csv
datasets/real/porto_taxi_traj/test.csv
datasets/real/porto_taxi_traj/processed/
# SUMO simulated: snapshots (9.9 GB), labels (12 GB), mapping (1 GB), zips
datasets/simulated/3zones/snapshots/
datasets/simulated/3zones/labels/
datasets/simulated/3zones/mapping/
datasets/simulated/3zones/*.zip

# ── Results: track metrics but not saved model binaries ───────────────────────
results/*/model/

# ── Reference PDFs (binary, use BibTeX entries instead) ───────────────────────
references/*.pdf

# ── Springer template unpacked dir (zip is the canonical source) ──────────────
Papers/Springer/Template/springer-nature-template/
DynamicMoeIntentGNN

# ── Commit scope: revised Springer manuscript only ────────────────────────────
# Ignore every untracked path except the active revised paper folder.
# Explicit entries for large/non-submission folders; the catch-all below covers
# anything not listed here as well.
models/
results/
analysis/
references/
datasets/
Papers/figures/
*
!.gitignore
!Papers/
Papers/*
!Papers/Springer/
Papers/Springer/*
!Papers/Springer/main/
!Papers/Springer/main/**